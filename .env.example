# Injecté automatiquement par l’intégration Neon-Managed ↔ Vercel
DATABASE_URL=
NEON_AUTH_BASE_URL=

# Optionnels : l’application sait les dériver automatiquement sur Vercel
NEON_AUTH_COOKIE_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Back-office plateforme privé — e-mails séparés par des virgules.
# Variable exclusivement serveur. Si elle est vide, /admin reste inaccessible.
PLATFORM_ADMIN_EMAILS=
