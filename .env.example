# Injecté automatiquement par l’intégration Neon-Managed ↔ Vercel
DATABASE_URL=
NEON_AUTH_BASE_URL=

# Optionnels : l’application sait les dériver automatiquement sur Vercel
NEON_AUTH_COOKIE_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Back-office plateforme privé.
# L’identifiant peut rester Admin. Le mot de passe doit être défini uniquement
# dans les variables d’environnement Vercel, jamais commité dans GitHub.
PLATFORM_ADMIN_USERNAME=Admin
PLATFORM_ADMIN_PASSWORD=
# Optionnel : secret dédié pour signer le cookie admin. À défaut, l’application
# dérive un secret serveur à partir de la configuration existante.
PLATFORM_ADMIN_SESSION_SECRET=
