# Injecté automatiquement par l’intégration Neon-Managed ↔ Vercel
DATABASE_URL=
NEON_AUTH_BASE_URL=

# Optionnels : l’application sait les dériver automatiquement sur Vercel
NEON_AUTH_COOKIE_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Back-office plateforme — liste d’e-mails séparés par des virgules.
# Alternative : un compte Neon Auth portant le rôle `platform_admin` est également autorisé.
# Ne jamais exposer cette valeur côté client.
PLATFORM_ADMIN_EMAILS=
