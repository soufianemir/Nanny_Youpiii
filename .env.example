# Injecté automatiquement par l’intégration Neon-Managed ↔ Vercel
DATABASE_URL=
NEON_AUTH_BASE_URL=

# Optionnels : l’application sait les dériver automatiquement sur Vercel
NEON_AUTH_COOKIE_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Back-office plateforme.
# Méthode 1 : accès dédié par identifiant/mot de passe.
# L’identifiant peut rester Admin. Le mot de passe doit être défini uniquement
# dans Vercel et ne doit jamais être commité dans GitHub.
PLATFORM_ADMIN_USERNAME=Admin
PLATFORM_ADMIN_PASSWORD=
# Optionnel : secret dédié pour signer le cookie admin. À défaut, un secret
# serveur est dérivé de la configuration existante.
PLATFORM_ADMIN_SESSION_SECRET=

# Méthode 2 (conservée) : comptes Neon Auth autorisés par e-mail.
# Alternative : un compte Neon Auth portant le rôle `platform_admin` est également autorisé.
PLATFORM_ADMIN_EMAILS=
